rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signed(){return request.auth!=null;}
  function verified(){return signed() && request.auth.token.email_verified==true;}
  function admin(){return signed() && (request.auth.token.get('admin',false)==true || (request.auth.token.email_verified==true && request.auth.token.email=='vermaraj.techit@gmail.com'));}
  function own(id){return signed() && get(/databases/$(database)/documents/listings/$(id)).data.owner_id==request.auth.uid;}
  function s(v,min,max){return v is string && v.size()>=min && v.size()<=max;}
  function photo(i,id){return request.resource.data.photos.size()<=i || (request.resource.data.photos[i] is string && request.resource.data.photos[i].matches('owners/'+request.auth.uid+'/listings/'+id+'/[A-Za-z0-9.-]+'));}
  function valid(id){let d=request.resource.data;return d.keys().hasOnly(['kind','title','description','locality','lat','lng','features','photos','status','rent','deposit','area_sqft','property_type','furnishing','available_from','fee','hours','access','owner_id','owner_name','created_at','updated_at','geohash'])
   && d.kind in ['rental','restroom'] && s(d.title,4,100) && s(d.description,15,2000) && s(d.locality,2,150) && s(d.owner_name,1,80)
   && d.lat is number && d.lat>=-90 && d.lat<=90 && d.lng is number && d.lng>=-180 && d.lng<=180
   && s(d.geohash,1,12) && d.features is list && d.features.size()<=10 && d.photos is list && d.photos.size()<=5
   && photo(0,id) && photo(1,id) && photo(2,id) && photo(3,id) && photo(4,id)
   && d.created_at is timestamp && d.updated_at==request.time
   && ((d.kind=='rental' && d.rent is number && d.rent>0 && d.rent<=100000000 && d.deposit is number && d.deposit>=0 && d.deposit<=100000000 && d.area_sqft is number && d.area_sqft>0 && d.area_sqft<=1000000 && d.property_type in ['Room','1 RK','1 BHK','2 BHK','3 BHK','House'] && d.furnishing in ['Unfurnished','Semi-furnished','Furnished'] && d.available_from is string && d.available_from.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}') && d.features.hasOnly(['Wi-Fi','Parking','Lift','Power backup','Water supply','Kitchen','Balcony','Pet friendly']))
   || (d.kind=='restroom' && (d.fee==null || (d.fee is number && d.fee>=0 && d.fee<=100000000)) && s(d.hours,2,160) && s(d.access,2,160) && d.features.hasOnly(['Wheelchair accessible','Women facilities','Baby changing','Drinking water','Gender neutral'])));}
  match /listings/{id} {
   allow read: if resource.data.status=='active' || (signed() && resource.data.owner_id==request.auth.uid) || admin();
   allow create: if verified() && valid(id) && request.resource.data.owner_id==request.auth.uid && request.resource.data.status in ['active','inactive'] && request.resource.data.created_at==request.time;
   allow update: if (verified() && resource.data.owner_id==request.auth.uid && resource.data.status!='hidden' && request.resource.data.status in ['active','inactive'] && request.resource.data.owner_id==resource.data.owner_id && request.resource.data.kind==resource.data.kind && request.resource.data.created_at==resource.data.created_at && valid(id)) || (admin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updated_at']) && request.resource.data.status in ['active','inactive','hidden'] && request.resource.data.updated_at==request.time);
   allow delete: if signed() && (resource.data.owner_id==request.auth.uid || admin());
  }
  match /listing_private/{id} {
   allow read: if own(id);
   allow create,update: if signed() && getAfter(/databases/$(database)/documents/listings/$(id)).data.owner_id==request.auth.uid && request.resource.data.keys().hasOnly(['address','owner_id']) && request.resource.data.owner_id==request.auth.uid && s(request.resource.data.address,0,500);
   allow delete: if signed() && resource.data.owner_id==request.auth.uid;
  }
  match /users/{uid}/saved/{id} {
   allow read,delete: if signed() && request.auth.uid==uid;
   allow create,update: if signed() && request.auth.uid==uid && request.resource.data.keys().hasOnly(['listing_id','created_at']) && request.resource.data.listing_id==id && request.resource.data.created_at==request.time;
  }
  match /enquiries/{id} {
   allow get: if signed() && (id.matches('.*_'+request.auth.uid) || request.auth.uid in [resource.data.sender_id,resource.data.owner_id]);
   allow list: if signed() && request.auth.uid in [resource.data.sender_id,resource.data.owner_id];
   allow create: if verified() && id==request.resource.data.listing_id+'_'+request.auth.uid && request.resource.data.keys().hasOnly(['listing_id','sender_id','sender_name','owner_id','message','reply','status','created_at','updated_at']) && request.resource.data.sender_id==request.auth.uid && request.resource.data.owner_id==get(/databases/$(database)/documents/listings/$(request.resource.data.listing_id)).data.owner_id && request.resource.data.owner_id!=request.auth.uid && get(/databases/$(database)/documents/listings/$(request.resource.data.listing_id)).data.status=='active' && get(/databases/$(database)/documents/listings/$(request.resource.data.listing_id)).data.kind=='rental' && s(request.resource.data.sender_name,1,80) && s(request.resource.data.message,10,1500) && request.resource.data.reply=='' && request.resource.data.status=='pending' && request.resource.data.created_at==request.time && request.resource.data.updated_at==request.time;
   allow update: if signed() && request.resource.data.updated_at==request.time && ((request.auth.uid==resource.data.owner_id && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reply','status','updated_at']) && s(request.resource.data.reply,0,1500) && request.resource.data.status in ['pending','replied','closed']) || (request.auth.uid==resource.data.sender_id && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updated_at']) && request.resource.data.status=='cancelled'));
  }
  match /reports/{id} {
   allow create: if verified() && request.resource.data.keys().hasOnly(['listing_id','reporter_id','reason','status','created_at']) && request.resource.data.reporter_id==request.auth.uid && s(request.resource.data.listing_id,1,200) && s(request.resource.data.reason,10,1000) && request.resource.data.status=='open' && request.resource.data.created_at==request.time;
   allow read: if admin() || (signed() && resource.data.reporter_id==request.auth.uid);
   allow update: if admin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) && request.resource.data.status in ['open','reviewed'];
  }
 }
}
